{
    "name": "emuniq/filament-qr-scanner",
    "description": "Camera components for Filament: QR/barcode scanning and quick photo capture, drop-in anywhere Blade renders — pages, resources, relation managers and modals.",
    "license": "MIT",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "livewire",
        "camera",
        "photo-capture",
        "webcam",
        "qr",
        "barcode",
        "scanner",
        "html5-qrcode"
    ],
    "authors": [
        {
            "name": "Israel Hussny",
            "email": "ihussny@gmail.com",
            "role": "Creator"
        }
    ],
    "support": {
        "issues": "https://github.com/isach5/filament-qr-scanner/issues",
        "source": "https://github.com/isach5/filament-qr-scanner"
    },
    "autoload": {
        "psr-4": {
            "Emuniq\\FilamentQrScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emuniq\\FilamentQrScanner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emuniq\\FilamentQrScanner\\QrScannerServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test:js": "node --test tests/js/",
        "test:js:coverage": "node --experimental-test-coverage --test tests/js/"
    }
}
